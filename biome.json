{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/commands/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/protocol/**",
                      "../protocol/*",
                      "**/spec/**",
                      "../spec/*",
                      "**/generated/**",
                      "../generated/*"
                    ],
                    "message": "commands speak the domain model; only src/client.ts may reach the protocol, the specification or the generated wrappers"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/models.ts", "src/cache/**", "src/rendering/**", "src/resolve.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/protocol/**",
                      "../protocol/*",
                      "./protocol/*",
                      "**/spec/**",
                      "../spec/*",
                      "./spec/*",
                      "**/generated/**",
                      "../generated/*",
                      "./generated/*",
                      "**/session/**",
                      "../session/*",
                      "./session/*",
                      "**/commands/**",
                      "../commands/*",
                      "./commands/*",
                      "**/client.js",
                      "../client.js",
                      "./client.js"
                    ],
                    "message": "the messenger boundary (CLI-26): what any messenger CLI could share may not know MAX — no protocol, spec, generated wrappers, session, client or commands"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
