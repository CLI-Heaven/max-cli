#!/usr/bin/env sh
# The next free backlog id, taken for good the moment it is printed.
#   bin/next-id MAX   ->   MAX-37
#
# Searching the text for the highest number gave out CLI-26 three times and MAX-16 and MAX-23
# twice on 2026-09-24: a number claimed on a branch is invisible to a session on another branch
# until it merges. The counter lives beside the git directory every worktree shares, so all
# sessions on this machine draw from it, under a lock. The text is still scanned — every branch,
# remote ones too — so a number used elsewhere is never handed out again.
set -eu
[ $# -eq 1 ] || { echo "usage: bin/next-id <PREFIX>   e.g. bin/next-id MAX" >&2; exit 2; }
prefix=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
case "$prefix" in
  RES|OPS|CORE|SPEC|MAX|CLI|DOC|PROTO|RISK) ;;
  *) echo "unknown prefix $prefix — see the Rules in docs/dev/BACKLOG.md" >&2; exit 2 ;;
esac

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
counters="$common/backlog-counters"

# Best effort: offline, the local refs still cover every session on this machine.
timeout 10 git -C "$root" fetch --quiet origin 2>/dev/null || true

allocate() {
  used=$(git -C "$root" log --all -p 2>/dev/null | grep -ohE "\b${prefix}-[0-9]+" | sed "s/^${prefix}-//" | sort -n | tail -1)
  stored=$(awk -v p="$prefix" '$1 == p { print $2 }' "$counters" 2>/dev/null | tail -1)
  max=${used:-0}
  [ "${stored:-0}" -gt "$max" ] && max=$stored
  n=$((max + 1))
  { grep -v "^${prefix} " "$counters" 2>/dev/null || true; echo "$prefix $n"; } > "$counters.$$"
  mv "$counters.$$" "$counters"
  printf '%s-%s\n' "$prefix" "$n"
}

exec 9>"$counters.lock"
flock 9
allocate
