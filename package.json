{
  "name": "@leemour/max-cli",
  "version": "0.2.0",
  "description": "A local command line interface for a personal MAX Messenger account, built for agents and scripts",
  "license": "MIT",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leemour/max-cli.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "bin": {
    "max": "dist/bin/max.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "generate": "pnpm build && node --experimental-strip-types scripts/generate.ts && node --experimental-strip-types scripts/commands.ts",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:bun": "bun run scripts/smoke.ts",
    "version:check": "node --experimental-strip-types scripts/version.ts",
    "version:sync": "node --experimental-strip-types scripts/version.ts --sync",
    "probe:ids": "pnpm build && node --experimental-strip-types scripts/id-shape.ts",
    "probe:edits": "pnpm build && node --experimental-strip-types scripts/probe-edits.ts",
    "probe:attachments": "pnpm build && node --experimental-strip-types scripts/probe-attachments.ts",
    "verify:live": "pnpm build && node --experimental-strip-types scripts/verify-commands.ts",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepublishOnly": "pnpm build",
    "probe:contacts": "pnpm build && node --experimental-strip-types scripts/probe-contacts.ts",
    "probe:token": "pnpm build && node --experimental-strip-types scripts/probe-token.ts"
  },
  "dependencies": {
    "@leemour/cli-core": "^0.1.0",
    "commander": "^15.0.0",
    "lossless-json": "^4.3.1",
    "string-width": "^8.2.2",
    "valibot": "^1.5.0",
    "wrap-ansi": "^10.0.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "lefthook": "^2.1.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
